#!/usr/bin/env node
// agentbox CLI (cloud): talk to a Claude Code agent in a sandbox, through the agentbox API on Cloudflare.
//
//   agentbox login                       sign in with GitHub (device flow); saves a 24 h agentbox token
//   agentbox run ["task"]                chat with Claude in jakehulberg2/infisical2
//   agentbox attach <id>                 reopen a session: see where it is, keep chatting
//   agentbox send <id> "message"         one-off follow-up, then exit
//   agentbox ls                          your recent sessions
//   agentbox logs <id>                   replay a session's full log
//   agentbox cancel <id> | logout
//
//   --verbose   also show the plumbing (Agent Vault revokes, stderr, raw events)
//   --detach    (run) queue the task and exit
import { readFileSync, writeFileSync, existsSync, mkdirSync, rmSync } from "node:fs";
import { homedir } from "node:os";
import { join, dirname } from "node:path";
import { createInterface } from "node:readline";

// ---------- config ----------
const BASE = process.env.AGENTBOX_URL || "https://agentbox-api.example.workers.dev";
const CREDS = join(process.env.XDG_CONFIG_HOME || join(homedir(), ".config"), "agentbox", "credentials");
const creds = (() => { try { return JSON.parse(readFileSync(CREDS, "utf8")); } catch { return {}; } })();
const TOKEN = creds.token || "";
const headers = { "content-type": "application/json", ...(TOKEN ? { authorization: `Bearer ${TOKEN}` } : {}) };
const ME = creds.login || "you";
const DEFAULT_REPO = "jakehulberg2/infisical2";
const isRepo = (s) => /^[\w.-]+\/[\w.-]+$/.test(s || "");

const argv = process.argv.slice(2);
const VERBOSE = argv.includes("--verbose") || argv.includes("-v");
const DETACH = argv.includes("--detach");
const pos = argv.filter((a) => !a.startsWith("-"));
const [cmd, ...args] = pos;

// ---------- terminal styling ----------
const TTY = process.stdout.isTTY;
const esc = (c) => (s) => (TTY ? `\x1b[${c}m${s}\x1b[0m` : String(s));
const c = {
  dim: esc("2"), bold: esc("1"), italic: esc("3"),
  red: esc("31"), green: esc("32"), yellow: esc("33"), blue: esc("34"), magenta: esc("35"), cyan: esc("36"), gray: esc("90"),
  orange: esc("38;5;209"), violet: esc("38;5;141"),
};
const width = () => Math.min(process.stdout.columns || 100, 110);

// light markdown: **bold**, `code`, # headings, - bullets
function md(text) {
  return text
    .split("\n")
    .map((line) => {
      if (/^#{1,6}\s/.test(line)) return c.bold(line.replace(/^#{1,6}\s/, ""));
      line = line.replace(/^(\s*)[-*]\s/, (_, s) => `${s}${c.gray("•")} `);
      line = line.replace(/\*\*([^*]+)\*\*/g, (_, t) => c.bold(t));
      line = line.replace(/`([^`]+)`/g, (_, t) => c.cyan(t));
      return line;
    })
    .join("\n");
}

// wrap plain-ish text to the terminal with a left gutter (ANSI-aware length)
const visible = (s) => s.replace(/\x1b\[[0-9;]*m/g, "");
function wrap(text, indent = "  ") {
  const max = width() - indent.length;
  const out = [];
  for (const para of text.split("\n")) {
    if (!visible(para).trim()) { out.push(""); continue; }
    let line = "";
    for (const word of para.split(" ")) {
      if (visible(line).length + visible(word).length + 1 > max && line) { out.push(line); line = word; }
      else line = line ? `${line} ${word}` : word;
    }
    out.push(line);
  }
  return out.map((l) => indent + l).join("\n");
}

// ---------- the thinking animation ----------
// A spinner plus a verb with a light sweeping across it, and an elapsed timer.
const VERBS = ["Thinking", "Pondering", "Reading the code", "Noodling", "Tinkering", "Brewing", "Untangling", "Scheming", "Cooking", "Mulling it over"];
const FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
const spinner = {
  timer: null, label: "", start: 0, tick: 0, verb: 0, fixed: false,
  set(label, { fixed = false } = {}) {
    if (!TTY) return;
    this.label = label; this.fixed = fixed;
    if (!this.timer) {
      this.start = Date.now(); this.tick = 0;
      this.timer = setInterval(() => this.draw(), 80);
    }
    this.draw();
  },
  think() { this.set(VERBS[this.verb % VERBS.length]); },
  draw() {
    this.tick++;
    if (!this.fixed && this.tick % 40 === 0) { this.verb++; this.label = VERBS[this.verb % VERBS.length]; }
    const secs = Math.floor((Date.now() - this.start) / 1000);
    const text = `${this.label}…`;
    const hot = (this.tick % (text.length + 8)) - 4; // sweeping highlight position
    let shimmer = "";
    for (let i = 0; i < text.length; i++) {
      const d = Math.abs(i - hot);
      const shade = d === 0 ? 231 : d === 1 ? 223 : d === 2 ? 216 : 209; // white -> warm orange
      shimmer += TTY ? `\x1b[38;5;${shade}m${text[i]}` : text[i];
    }
    const frame = c.orange(FRAMES[this.tick % FRAMES.length]);
    process.stdout.write(`\r\x1b[2K  ${frame} ${shimmer}\x1b[0m ${c.gray(`${secs}s · ctrl-c to detach`)}`);
  },
  clear() {
    if (!TTY) return;
    if (this.timer) { clearInterval(this.timer); this.timer = null; }
    process.stdout.write("\r\x1b[2K");
  },
};
const print = (s = "") => { const was = !!spinner.timer; spinner.clear(); console.log(s); if (was) spinner.set(spinner.label, { fixed: spinner.fixed }); };

// ---------- API ----------
async function api(method, path, body) {
  const res = await fetch(BASE + path, { method, headers, body: body && JSON.stringify(body) });
  const out = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(out.error || `HTTP ${res.status}`);
  return out;
}

// ---------- rendering events ----------
const short = (s, n = 90) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
function toolSummary(name, input = {}) {
  const pick = input.command ?? input.file_path ?? input.path ?? input.pattern ?? input.url ?? input.query ?? input.description;
  if (name === "TodoWrite") return `${(input.todos || []).length} todos`;
  return short(String(pick ?? JSON.stringify(input)).replace(/\s+/g, " ").replace(/^\/workspace\//, ""));
}

let lastSeq = 0;
let costSoFar = 0; // Claude's cost is cumulative per conversation; show each turn's share
let turnStart = 0;
let lastStatus = "";
function render(ev) {
  lastSeq = Math.max(lastSeq, ev.seq);
  const d = ev.data;
  if (ev.kind === "status") {
    lastStatus = d.status;
    if (d.status === "queued") spinner.set("Waiting for a box", { fixed: true });
    else if (d.status === "starting") spinner.set("Warming up the box", { fixed: true });
    else if (d.status === "running") { turnStart = Date.now(); spinner.think(); }
    else if (d.status === "finishing") spinner.set("Pushing to GitHub", { fixed: true });
    else if (d.status === "failed") { spinner.clear(); print(c.red(`  ✗ failed: ${d.error || "unknown error"}`)); }
    else if (d.status === "cancelled") { spinner.clear(); print(c.yellow("  ⊘ cancelled")); }
    else if (["idle", "sleeping"].includes(d.status)) spinner.clear();
    return;
  }
  if (ev.kind === "message") return print(`\n${c.orange("›")} ${c.bold(d.prompt)}`);
  if (ev.kind === "log") {
    if (d.tag === "box") {
      const how = d.mode === "restore" ? "woke" : d.mode === "warm" ? "resuming in" : "new box";
      return print(c.gray(`  ◇ ${how} ${d.box} · ${d.ip} · ${d.repo} → ${d.branch}`));
    }
    if (d.tag === "creds" && d.action === "minted")
      return print(c.gray(`  ${c.violet("⚿")} Agent Vault session ${d.avSession.slice(0, 8)} · bundle ${d.bundle} · the box only holds a placeholder key`));
    if (d.tag === "creds" && d.action === "revoked") return VERBOSE && print(c.gray(`  ⚿ revoked ${d.avSession.slice(0, 8)}`));
    if (d.tag === "parked") return; // shown by the prompt hint
    if (d.tag === "waiting") return spinner.set("All boxes busy, waiting for one", { fixed: true });
    if (d.tag === "nochanges") return print(c.gray("  · no code changes"));
    if (VERBOSE) print(c.gray(`  ${d.msg || d.stderr || d.stdout}`));
    return;
  }
  if (ev.kind === "error") return print(c.red(`  ✗ ${d.msg}`));
  if (ev.kind === "pr") {
    if (d.url) return print(`  ${c.green("↗")} ${d.updated ? "updated" : "opened"} ${c.green(d.url)}`);
    if (d.diffStat) return print(c.gray(`  ± ${d.diffStat.trim().split("\n").pop().trim()}`));
    if (d.note) return print(c.gray(`  · ${d.note}`));
    return;
  }
  if (ev.kind === "result") {
    const secs = turnStart ? Math.round((Date.now() - turnStart) / 1000) : Math.round((d.duration_ms || 0) / 1000);
    const total = d.total_cost_usd ?? 0;
    const turnCost = Math.max(0, total - costSoFar);
    costSoFar = Math.max(costSoFar, total);
    return print(c.gray(`  ✓ ${d.num_turns} step${d.num_turns === 1 ? "" : "s"} · $${turnCost.toFixed(3)} this turn · ${secs}s`));
  }
  if (ev.kind === "agent") {
    if (d.type === "assistant") {
      for (const part of d.message?.content || []) {
        if (part.type === "text" && part.text.trim()) print(`\n${wrap(md(part.text.trim()))}\n`);
        if (part.type === "tool_use") {
          print(`  ${c.orange("⏺")} ${c.bold(part.name)} ${c.gray(toolSummary(part.name, part.input))}`);
          spinner.set(`Running ${part.name}`, { fixed: true });
        }
      }
    }
    if (d.type === "user") {
      for (const part of d.message?.content || []) {
        if (part.type !== "tool_result") continue;
        const body = Array.isArray(part.content) ? part.content.map((x) => x.text || "").join("\n") : String(part.content ?? "");
        const lines = body.split("\n").filter(Boolean).length;
        print(part.is_error ? c.red(`    ⎿ ${short(body.split("\n")[0] || "error", 80)}`) : c.gray(`    ⎿ ${lines} line${lines === 1 ? "" : "s"}`));
        spinner.think();
      }
    }
    if (VERBOSE && !["assistant", "user"].includes(d.type)) print(c.gray(`  [${d.type}${d.subtype ? `:${d.subtype}` : ""}]`));
  }
}

// Stream a session's events over a WebSocket to its Durable Object until the session settles
// (the DO closes the socket). Resolves with the final status.
async function follow(id, after = 0) {
  const url = `${BASE.replace(/^http/, "ws")}/sessions/${id}/stream?after=${Math.min(after, Number.MAX_SAFE_INTEGER)}&access_token=${encodeURIComponent(TOKEN)}`;
  await new Promise((resolve, reject) => {
    const ws = new WebSocket(url);
    let opened = false;
    ws.onopen = () => { opened = true; };
    ws.onmessage = (e) => render(JSON.parse(e.data));
    ws.onerror = () => { if (!opened) reject(new Error("couldn't open the event stream (run agentbox login?)")); };
    ws.onclose = () => resolve();
  });
  spinner.clear();
  return (await api("GET", `/sessions/${id}`)).status;
}

// ---------- the chat loop ----------
function header(repo, id) {
  const line = c.gray("─".repeat(Math.max(10, width() - 2)));
  console.log(`\n${c.orange("◆")} ${c.bold("agentbox")}  ${c.gray([repo, id].filter(Boolean).join(" · "))}\n${line}`);
}

// One readline per prompt, closed right after, so ctrl-c behaves normally while the agent works.
function ask(promptText) {
  return new Promise((resolve) => {
    const rl = createInterface({ input: process.stdin, output: process.stdout, terminal: TTY });
    let answered = false;
    rl.on("SIGINT", () => rl.close());
    rl.on("close", () => { if (!answered) resolve(null); });
    rl.question(promptText, (answer) => { answered = true; rl.close(); resolve(answer); });
  });
}

async function chat(id, { after = 0 } = {}) {
  for (;;) {
    const controller = new AbortController();
    const onSigint = () => {
      spinner.clear();
      console.log(c.gray(`\n  detached. the agent keeps working. reattach with: agentbox attach ${id}`));
      controller.abort();
      process.exit(0);
    };
    process.once("SIGINT", onSigint);
    const status = await follow(id, after);
    process.off("SIGINT", onSigint);
    if (status === "failed" || status === "cancelled") return;

    console.log(c.gray(`  ${status === "sleeping" ? "box stopped · disk kept, a reply wakes it" : "box parked for 5 min · replies resume instantly"} · ctrl-d to leave`));
    let text;
    do { text = await ask(`\n${c.orange("›")} `); } while (text !== null && !text.trim());
    if (text === null || ["exit", "quit", "/exit"].includes(text.trim())) {
      console.log(c.gray(`\n  session ${id} stays ${status}. pick it back up with: agentbox attach ${id}`));
      return;
    }
    if (text.trim() === "/cancel") { await api("POST", `/sessions/${id}/cancel`); console.log(c.yellow("  ⊘ cancelled")); return; }
    if (TTY) process.stdout.write("\x1b[1A\r\x1b[2K"); // replace the raw input line with the styled one from the event
    const r = await api("POST", `/sessions/${id}/messages`, { prompt: text.trim() });
    after = r.eventSeq - 1;
  }
}

// ---------- commands ----------
const ago = (iso) => {
  const s = Math.round((Date.now() - new Date(iso)) / 1000);
  return s < 60 ? `${s}s` : s < 3600 ? `${Math.round(s / 60)}m` : s < 86400 ? `${Math.round(s / 3600)}h` : `${Math.round(s / 86400)}d`;
};
const dot = (st) =>
  ({ running: c.orange("●"), starting: c.orange("●"), finishing: c.orange("●"), queued: c.yellow("●"), idle: c.green("●"), sleeping: c.blue("●"), failed: c.red("●"), cancelled: c.gray("●"), succeeded: c.green("●") })[st] || c.gray("●");

async function login() {
  const start = await api("POST", "/auth/device");
  console.log(`\n  open ${c.cyan(start.verification_uri)} and enter ${c.bold(start.user_code)}\n`);
  spinner.set("Waiting for GitHub", { fixed: true });
  let wait = (start.interval || 5) * 1000;
  for (;;) {
    await new Promise((ok) => setTimeout(ok, wait));
    const r = await api("POST", "/auth/token", { device_code: start.device_code });
    if (r.pending) { if (r.interval) wait = r.interval * 1000; continue; }
    spinner.clear();
    mkdirSync(dirname(CREDS), { recursive: true });
    writeFileSync(CREDS, JSON.stringify({ token: r.token, login: r.login, expiresAt: r.expiresAt }), { mode: 0o600 });
    return console.log(`  ${c.green("✓")} logged in as ${c.bold(r.login)} until ${new Date(r.expiresAt).toLocaleString()}`);
  }
}

async function main() {
  if (cmd === "login") return login();
  if (cmd === "logout") { rmSync(CREDS, { force: true }); return console.log("  logged out"); }
  if (cmd && cmd !== "help" && !TOKEN) throw new Error("not logged in: run agentbox login");

  if (cmd === "run") {
    // agentbox run                      -> chat in the default repo
    // agentbox run "task"               -> same, starting with that task
    // agentbox run owner/repo ["task"]  -> another repo
    const repo = isRepo(args[0]) ? args[0] : DEFAULT_REPO;
    let task = (isRepo(args[0]) ? args.slice(1) : args).join(" ").trim();
    header(repo);
    if (!task) {
      console.log(c.gray("  what should Claude do? ctrl-d to quit"));
      do { task = await ask(`\n${c.orange("›")} `); } while (task !== null && !task.trim());
      if (task === null) return;
      task = task.trim();
      if (TTY) process.stdout.write("\x1b[1A\r\x1b[2K");
    }
    const s = await api("POST", "/sessions", { repo, prompt: task });
    if (DETACH) return console.log(`${c.orange("◆")} queued ${c.bold(s.id)}  ${c.gray(`agentbox attach ${s.id}`)}`);
    console.log(`${c.orange("›")} ${c.bold(task)}  ${c.gray(s.id)}`);
    return chat(s.id);
  }

  if (cmd === "attach") {
    const s = await api("GET", `/sessions/${args[0]}`);
    header(s.repo, s.id);
    costSoFar = s.cost_usd ?? 0;
    console.log(c.gray(`  ${dot(s.status)} ${s.status} · ${s.num_turns ?? 0} agent turns · $${(s.cost_usd ?? 0).toFixed(3)}${s.pr_url ? ` · ${s.pr_url}` : ""}`));
    if (["failed", "cancelled"].includes(s.status)) return console.log(c.red(`  ${s.error || s.status}`));
    // only new activity: if it's working, watch it live; if it's idle or asleep, go straight to the prompt
    return chat(s.id, { after: Number.MAX_SAFE_INTEGER });
  }

  if (cmd === "send") {
    const [id, ...p] = args;
    const r = await api("POST", `/sessions/${id}/messages`, { prompt: p.join(" ") });
    await follow(id, r.eventSeq - 1);
    return;
  }

  if (cmd === "logs") {
    const s = await api("GET", `/sessions/${args[0]}`);
    header(s.repo, s.id);
    await follow(args[0], 0);
    return;
  }

  if (cmd === "ls") {
    const rows = await api("GET", "/sessions");
    if (!rows.length) return console.log(c.gray("  no sessions yet"));
    console.log();
    for (const s of rows.slice(0, 20)) {
      const pr = s.pr_url ? c.green(`#${s.pr_url.split("/").pop()}`) : c.gray("  -");
      console.log(
        `  ${dot(s.status)} ${c.bold(s.id)}  ${s.status.padEnd(9)} ${c.gray(ago(s.created_at).padStart(4))}  ${pr.padEnd(TTY ? 13 : 4)} ${c.gray(`$${(s.cost_usd ?? 0).toFixed(2)}`)}  ${c.cyan(s.repo)}  ${short(s.prompt, 50)}`,
      );
    }
    console.log();
    return;
  }

  if (cmd === "cancel") return console.log((await api("POST", `/sessions/${args[0]}/cancel`)).status);

  console.log(`
${c.orange("◆")} ${c.bold("agentbox")}  ${c.gray("Claude Code in a sandbox, credentials brokered by Agent Vault")}

  ${c.bold("agentbox login")}                       sign in with GitHub${TOKEN ? c.gray(` (signed in as ${ME})`) : ""}
  ${c.bold("agentbox run")} ["task"]                chat with Claude in ${DEFAULT_REPO}
  ${c.bold("agentbox attach")} <id>                 pick a session back up
  ${c.bold("agentbox ls")}                          recent sessions
  ${c.bold("agentbox logs")} <id>                   replay a session
  ${c.bold("agentbox send")} <id> "message"         one-off follow-up
  ${c.bold("agentbox cancel")} <id> · ${c.bold("agentbox logout")}

  ${c.gray("in a chat:  type to reply · /cancel · ctrl-d to leave · ctrl-c to detach")}
  ${c.gray("flags:      --verbose  --detach")}
`);
}

main().catch((e) => {
  spinner.clear();
  console.error(c.red(`error: ${e.message}`));
  process.exit(1);
});
