   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Clients connect with the WebSocket hibernation API (ctx.acceptWebSocket): replay from SQLite after\n?after=<seq>, then broadcast with ctx.getWebSockets(). The DO closes sockets when the session settles.",
   "originalText": "Clients connect with the WebSocket hibernation API (ctx.acceptWebSocket): replay from SQLite after\n?after=<seq>, then broadcast with ctx.getWebSockets(). The DO closes sockets when the session settles.",
