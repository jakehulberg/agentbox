   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The sandbox never talks to the control plane. The DO pulls; the box only prints to stdout. A compromised\nbox has no write path into session state.",
   "originalText": "The sandbox never talks to the control plane. The DO pulls; the box only prints to stdout. A compromised\nbox has no write path into session state.",
